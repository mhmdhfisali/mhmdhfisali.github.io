cat << 'EOF' > .gitignore
# Dependencies
**/node_modules/
**/.pnp
**/.pnp.js

# Next.js Build & Outputs
**/.next/
**/out/

# Compiled Sanity Studio & Caches
**/dist/
**/.sanity/

# Logs & Testing
**/logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
**/coverage/

# Environment Variables & Local Configs
*.local
.env
.env.*

# Typescript & OS Files
*.tsbuildinfo
.DS_Store
*.pem
EOF
